# .env.template — environment variables read by pid-gated-agent-learning providers.
#
# Copy this file to `.env` (which is gitignored) and fill in only the keys for
# the providers you plan to use. Blank values fall back to each provider's
# built-in default.
#
#   cp .env.template .env
#
# Load it before running examples/tests, e.g.:
#   set -a; source .env; set +a           # bash/zsh
#   # or: python -c "from dotenv import load_dotenv; load_dotenv()"
#   # or: direnv allow      (if you have an .envrc)
#
# Constructor arguments always win over env vars; env vars are the convenient
# default for notebooks and quick experiments.


# ---- Anthropic -------------------------------------------------------------
# Required by AnthropicProvider when no api_key= is passed to the constructor.
# Get a key at https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# ---- Google Gemini ---------------------------------------------------------
# Required by GeminiProvider when no api_key= is passed to the constructor.
# Get a key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=

# ---- DeepSeek --------------------------------------------------------------
# Required by DeepSeekProvider when no api_key= is passed to the constructor.
# DeepSeek uses an OpenAI-compatible API, so this provider is a thin wrapper
# over OpenAIProvider pointed at https://api.deepseek.com.
# Get a key at https://platform.deepseek.com/api_keys.
DEEPSEEK_API_KEY=

# ---- OpenAI (and OpenAI-compatible proxies) --------------------------------
# Required by OpenAIProvider when no api_key= is passed to the constructor.
# Get a key at https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# Optional: pin the model used by OpenAIProvider. Leave blank to let the
# provider fall back to its built-in default. When routing through an
# OpenAI-compatible proxy (OpenRouter, Azure, LiteLLM, a local server, ...),
# set OPENAI_MODEL to the proxy's model string — e.g. for OpenRouter:
#
#   OPENAI_MODEL=anthropic/claude-opus-4-7
#
# and point OPENAI_BASE_URL at the proxy by uncommenting the line below.
OPENAI_MODEL=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ---- Ollama (local, no key) ------------------------------------------------
# OllamaProvider talks to a local Ollama server over HTTP and needs no key.
# Override the endpoint to point at a remote Ollama instance or an SSH tunnel.
OLLAMA_ENDPOINT=http://localhost:11434
