# Template for environment variables read by pid-gated-agent-learning providers.
#
# Copy this file to `.env` (which is gitignored) and fill in your own keys:
#   cp .env.template .env
#
# Then load it before running examples/tests, e.g.:
#   set -a; source .env; set +a           # bash/zsh
#   or install python-dotenv and call load_dotenv() in your script
#   or use direnv (`direnv allow`) if you have an .envrc

# ---- OpenAI ----------------------------------------------------------------
# Required by OpenAIProvider when no api_key= is passed explicitly.
OPENAI_API_KEY=
# Optional: default model (otherwise the provider falls back to gpt-4o-mini).
OPENAI_MODEL=
# Optional: override the API base URL. Useful for Azure, OpenRouter, or any
# OpenAI-compatible proxy (e.g. OPENAI_BASE_URL=https://openrouter.ai/api/v1).
OPENAI_BASE_URL=

# ---- Anthropic -------------------------------------------------------------
# Required by AnthropicProvider when no api_key= is passed explicitly.
ANTHROPIC_API_KEY=
# Optional: default model (otherwise the provider falls back to claude-sonnet-4-6).
ANTHROPIC_MODEL=

# ---- Google Gemini ---------------------------------------------------------
# Required by GeminiProvider when no api_key= is passed explicitly.
GEMINI_API_KEY=
# Optional: default model (otherwise the provider falls back to gemini-2.0-flash).
GEMINI_MODEL=

# ---- DeepSeek --------------------------------------------------------------
# Required by DeepSeekProvider when no api_key= is passed explicitly.
# DeepSeek uses an OpenAI-compatible API, so this provider is a thin wrapper
# that routes OpenAIProvider at https://api.deepseek.com.
DEEPSEEK_API_KEY=
# Optional: default model (otherwise the provider falls back to deepseek-chat).
DEEPSEEK_MODEL=

# ---- Ollama (local) --------------------------------------------------------
# OllamaProvider defaults to http://localhost:11434 and does not require a key.
# Uncomment to override the endpoint (e.g., remote Ollama instance or SSH tunnel).
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
